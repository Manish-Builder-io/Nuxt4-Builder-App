# Builder.io public API key (read at build time; safe to expose to the browser).
# Use NUXT_BUILDER_API_KEY on Vercel (it rejects names containing PUBLIC).
# NUXT_PUBLIC_BUILDER_API_KEY is also accepted and takes precedence.
NUXT_BUILDER_API_KEY=your-builder-public-api-key

# Optional: bypass the SDK cache (seconds). 0 = always fetch fresh (best for repros).
NUXT_BUILDER_CACHE_SECONDS=0
